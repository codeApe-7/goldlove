# Local development only. Copy to .env and replace every placeholder.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password
PHONE_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
PHONE_SEARCH_KEY=replace-with-a-different-openssl-rand-base64-32-output

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=operator
ADMIN_BOOTSTRAP_DISPLAY_NAME=Operator
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-initial-admin-password

# Comma-separated exact browser origins. Mini-program header tokens do not use this browser check.
BROWSER_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
AUTH_COOKIE_SECURE=false
