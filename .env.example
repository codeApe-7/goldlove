# Local development only. Copy to .env and replace every placeholder.
POSTGRES_OWNER_PASSWORD=replace-with-a-long-random-owner-password
DB_PASSWORD=replace-with-a-different-runtime-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# Tencent Cloud COS (private bucket; keys stay server-side, never shipped to H5/mini-program)
COS_SECRET_ID=replace-with-tencent-cloud-secret-id
COS_SECRET_KEY=replace-with-tencent-cloud-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET=loveplatform-1314980040

# 易支付 XPay V2（RSA2 双向签名，指定支付宝）。全部只存服务端，绝不随前端包下发。
# 私钥/公钥填 PEM 原文，多行值在 .env 中写成单行并用 \n 表示换行。
# 五项缺一，支付相关接口即返回 PAYMENT_CHANNEL_NOT_CONFIGURED，其余功能不受影响。
XPAY_PID=
XPAY_MERCHANT_PRIVATE_KEY=
XPAY_PLATFORM_PUBLIC_KEY=
XPAY_NOTIFY_URL=
XPAY_RETURN_URL=
# 渠道服务商网关地址，必填（刻意不设默认值，服务商域名属于部署配置）
XPAY_BASE_URL=

# 启用的线上支付渠道；留空则取唯一已配置渠道
ONLINE_PAYMENT_PROVIDER=XPAY_ALIPAY

# VIP 升级下单金额（分）与升 SVIP 的累计付费额度阈值（分）
VIP_UPGRADE_AMOUNT_MINOR=100
MEMBERSHIP_SVIP_THRESHOLD_MINOR=59900

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=operator
ADMIN_BOOTSTRAP_DISPLAY_NAME=Operator
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-initial-admin-password

# Comma-separated exact browser origins. Mini-program header tokens do not use this browser check.
# Use "*" to disable the origin check entirely (dev only; do not use in production).
BROWSER_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
AUTH_COOKIE_SECURE=false

# Keep "none" when API is reached directly. Use "framework" only behind a trusted proxy that overwrites forwarded headers.
SERVER_FORWARD_HEADERS_STRATEGY=none
